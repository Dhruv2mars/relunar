{
  "name": "relunar-repo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "brace-expansion": "1.1.16",
    "postcss": "8.5.16",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "bun packages/cli/scripts/e2e-smoke.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run test typecheck build",
    "release:trust": "npx npm@11.17.0 trust github @dhruv2mars/relunar --file release.yml --repo Dhruv2mars/relunar --allow-publish --yes",
    "release:tag": "node scripts/release-tag.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "turbo": "2.10.6",
    "typescript": "^6.0.3"
  }
}
